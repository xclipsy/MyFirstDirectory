nombre = str(input("Ingrese el nombre del cliente: "))

productos_comprados = []
precios_unitarios = []
cantidades = []

def productos_a_comprar():
    while True:
        producto = str(input("Ingrese el nombre del producto: "))
        precio_unitario = float(input("Ingrese el precio unitario del producto: "))
        cantidad_del_producto = int(input("Ingrese la cantidad de ese producto: "))
        
        productos_comprados.append(producto)
        precios_unitarios.append(precio_unitario)
        cantidades.append(cantidad_del_producto)
        while True:
            try:
                otro_producto = str(input("¿Desea agregar otro producto? (si/no): ")).lower()
                if otro_producto == "no":
                    return 
                elif otro_producto == "si":
                    break 
                else:
                    print("Respuesta no válida, intente nuevamente")
            except:
                print("Error en la entrada, intente nuevamente")

productos_a_comprar()
membresia = str(input("¿El cliente tiene membresía? (si/no): ")).lower()

subtotal = sum(precios_unitarios[i] * cantidades[i] for i in range(len(productos_comprados)))
iva = subtotal * 0.16
descuento = subtotal * 0.10 if membresia == "si" else 0

total = subtotal + iva - descuento

print("\n" + "="*70)
print("FACTURA DE VENTA".center(70))
print("="*70)
print(f"Cliente: {nombre}")
print("-"*70)
print(f"{'Producto':<25} {'Precio Unit.':<15} {'Cantidad':<15}")
print("-"*70)

for i in range(len(productos_comprados)):
    print(f"{productos_comprados[i]:<25} ${precios_unitarios[i]:<14.2f} {cantidades[i]:<15}")

print("-"*70)
print(f"Total de productos comprados: {sum(cantidades)}")
print(f"Subtotal: ${subtotal:.2f}")
print(f"IVA (16%): ${iva:.2f}")

if membresia == "si":
    print(f"Descuento (membresía 10%): ${descuento:.2f}")
else:
    print(f"Descuento: ${descuento:.2f}")

print("-"*70)
print(f"Total a pagar: ${total:.2f}")
print("="*70)