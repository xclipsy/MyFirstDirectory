print("Bienvenido al sistema de Parqueadero")
capacidad_parqueadero = 10
activador = 0

while activador == 0:
    respuesta =(input("¿Desea ingresar un nuevo vehículo o sacar uno existente? (ingresar/sacar): ")).lower()
    
    if respuesta == "ingresar":
        if capacidad_parqueadero > 0:
            capacidad_parqueadero -= 1
            print(f"Vehículo ingresado. Espacios disponibles: {capacidad_parqueadero}")
        else:
            print("No hay espacios disponibles en el parqueadero")
    elif respuesta == "sacar":
        if capacidad_parqueadero < 10:
            capacidad_parqueadero += 1
            print(f"Vehículo sacado. Espacios disponibles: {capacidad_parqueadero}")
        else:
            print("No hay vehículos para sacar")
    else:
        print("Opción no válida, intente nuevamente")

    continuar = str(input("¿Desea realizar otra operación? (si/no): ")).lower()
    if continuar == "no":
        print("Gracias por usar el sistema de parqueadero")
        activador = 1
    elif continuar != "si":
        print("Opción no válida")